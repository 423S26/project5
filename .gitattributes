# Normalize line endings to LF on commit, across all platforms.
* text=auto eol=lf

# Force these to always be LF.
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.csv text eol=lf

# Treat these as binary — don't touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
